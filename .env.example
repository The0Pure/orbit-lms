# ─────────────────────────────────────────────────────────────
# ORBIT LEARNING PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values.
# Add ALL these to Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Client-safe — VITE_ prefix exposes to browser) ──
# Get from Supabase Dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ── Supabase Service Role Key (SERVER-ONLY — never VITE_ prefix!) ──
# Used exclusively by Vercel serverless functions (api/*.js).
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Stripe (SERVER-ONLY) ───────────────────────────────────────
# Get from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Get from Stripe Dashboard → Developers → Webhooks → Signing secret
# Point the webhook endpoint at: https://your-domain.vercel.app/api/verify-payment
# Listen for event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App Config ─────────────────────────────────────────────────
VITE_APP_NAME=Orbit Learning
VITE_APP_URL=https://your-domain.vercel.app
VITE_SUPPORT_EMAIL=support@your-domain.com

# ── EmailJS (send certificate emails) ─────────────────────────
# Sign up free at https://emailjs.com
VITE_EMAILJS_SERVICE_ID=service_XXXXXXX
VITE_EMAILJS_TEMPLATE_ID=template_XXXXXXX
VITE_EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXX
